{
  "name": "overtone-captions",
  "version": "0.1.0",
  "description": "Captions cut for wide and tall video: re-cut SRT or WebVTT for 16:9 and 9:16 by reading rules, offline, or transcribe audio and video with several speech engines and a guarded LLM editor. Writes the Overtone format, WebVTT, SRT, text and MP4 with burned-in captions.",
  "keywords": [
    "captions",
    "subtitles",
    "transcription",
    "transcript",
    "diarization",
    "word-timing",
    "webvtt",
    "srt",
    "llm",
    "whisper",
    "cli",
    "overtone"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "overtone": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "typecheck": "tsc -p . --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "openai": "^7.41.0",
    "overtone-format": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonthq/overtone-captions.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/lonthq/overtone-captions#readme",
  "bugs": {
    "url": "https://github.com/lonthq/overtone-captions/issues"
  }
}
