{
  "name": "videojs-overtone",
  "version": "0.1.0",
  "description": "video.js plugin that plays Overtone captions: a line cut per screen shape, semantic styling with style packs, and a plain mode",
  "keywords": [
    "videojs",
    "videojs-plugin",
    "video.js",
    "captions",
    "subtitles",
    "accessibility",
    "overtone"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup && node scripts/style-packs.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "overtone-format": "^0.1.0"
  },
  "peerDependencies": {
    "video.js": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonthq/overtone-captions.git",
    "directory": "packages/videojs"
  },
  "homepage": "https://github.com/lonthq/overtone-captions#readme",
  "bugs": {
    "url": "https://github.com/lonthq/overtone-captions/issues"
  }
}
