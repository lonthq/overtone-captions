{
  "name": "overtone",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "build": "npm run build -w overtone-format && npm run build -w videojs-overtone && npm run build -w overtone-captions",
    "typecheck": "tsc -p packages/format --noEmit && tsc -p packages/videojs --noEmit && tsc -p packages/cli --noEmit",
    "demo": "npm run build && node examples/demo/serve.mjs",
    "styles:dev": "npm run build && node examples/styles/dev.mjs",
    "styles:previews": "npm run build && node examples/styles/previews.mjs",
    "test:styles": "vitest run packages/videojs/test/style-packs.test.ts",
    "test:lang": "vitest run packages/cli/test/lang-packs.test.ts packages/cli/test/lang-examples.test.ts",
    "test:live": "OVERTONE_LIVE=1 vitest run packages/cli/test/live.test.ts",
    "site:build": "npm run build && node site/scripts/build.mjs",
    "site:preview": "node site/scripts/preview.mjs",
    "bench": "node bench/fetch.mjs && node bench/run.mjs && node bench/score.mjs",
    "bench:gate": "node bench/gate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "cmu-pronouncing-dictionary": "3.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "video.js": "^8.24.2",
    "videojs-vtt.js": "^0.15.5",
    "vitest": "^5.0.5"
  }
}
