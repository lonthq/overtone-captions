# Copy this file to .env and fill in the providers you use. Never commit .env (it is git-ignored).
# The CLI reads .env from the directory you run it in; `npm run test:live` reads the one at the repo root.
# Variables that are already set in your environment win over this file.
# Only the providers you select with --text / --timing / --llm need keys. The defaults need OPENAI_API_KEY and the
# AZURE_SPEECH_* lines. One exception: with ELEVENLABS_API_KEY set, ElevenLabs Scribe also hears the whole file as the
# second hearing: it gives the word times and votes on the words (--timing-second-opinion none turns that off).
# For films, music or noisy audio we recommend setting it: without it, timing on such material is less accurate.

# --- OpenAI (provider: openai; text, llm, and timing + speakers with --timing openai) ---
# OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (used for both text and llm roles). Such servers may not enforce
# strict JSON schemas; the CLI validates every LLM response anyway.
# OPENAI_BASE_URL=
# Optional: json_schema (default) or json_object, for OpenAI-compatible servers without JSON-schema support.
# OPENAI_RESPONSE_FORMAT=

# --- Azure OpenAI (provider: azure-openai; select with --text azure-openai:<deployment> --llm azure-openai:<deployment>) ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# Optional. Set = classic deployments API for both roles with this api-version. Unset = classic deployments API with
# api-version=2025-04-01-preview for transcription (the v1 path 404s there), and the Azure v1 API for the llm role.
# AZURE_OPENAI_API_VERSION=
# Optional: the model behind your transcription deployment. Only matters together with the next variable.
# AZURE_OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Optional opt-in (1 or true): with TRANSCRIBE_MODEL=gpt-transcribe also send `languages` and `keywords`.
# AZURE_OPENAI_TRANSCRIBE_KEYWORDS=

# --- Anthropic (provider: anthropic, llm role only) ---
# ANTHROPIC_API_KEY=
# Optional: another server for the Messages API (a gateway). ANTHROPIC_AUTH_TOKEN is not used.
# ANTHROPIC_BASE_URL=

# --- Azure AI Speech (provider: azure-speech, timing + speakers; the default timing provider) ---
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# Optional: replaces https://<region>.api.cognitive.microsoft.com, e.g. a custom domain.
# AZURE_SPEECH_ENDPOINT=https://<name>.cognitiveservices.azure.com
# Optional: profanity as spoken (none, the default: captions are verbatim), masked (f*** becomes ****) or removed.
# AZURE_SPEECH_PROFANITY=none

# --- Azure MAI-Transcribe (provider: azure-mai; text and/or timing + speakers: --timing azure-mai, or --text azure-mai --timing same) ---
# Key of an Azure AI Foundry (or Speech) resource in a region that serves MAI-Transcribe-2 (e.g. northeurope, eastus).
# AZURE_MAI_KEY=
# AZURE_MAI_REGION=northeurope
# Or the resource's host instead of the region:
# AZURE_MAI_ENDPOINT=https://<name>.cognitiveservices.azure.com

# --- ElevenLabs Scribe (provider: elevenlabs; text and/or timing + speakers: --timing elevenlabs, or --text elevenlabs --timing same) ---
# A key with the speech-to-text permission is enough. When it is set, Scribe is also the default second hearing
# (--timing-second-opinion auto): it hears the whole file next to the timing provider, gives the word times, and
# votes on the words; snippets where nobody heard anything are sent to it again. Recommended for films, music and
# noisy audio (measured: $0.004–0.013 per audio minute more at list prices).
# Without Azure: --timing elevenlabs with this key plus OPENAI_API_KEY (the default text model and editor).
# ELEVENLABS_API_KEY=
# Optional: another host (default https://api.elevenlabs.io), e.g. EU data residency.
# ELEVENLABS_BASE_URL=https://api.eu.residency.elevenlabs.io
# Optional: seconds to wait for each request before it is sent once more (default 0.2 s per audio second, at
# least 60). ElevenLabs may still bill a request that was given up on.
# ELEVENLABS_TIMEOUT_SECONDS=120

# --- Local mode: whisper.cpp (provider: whisper-cpp) and Ollama (provider: ollama); no keys needed ---
# Optional: the whisper-cli binary (default: whisper-cli on PATH).
# WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
# Optional: a folder with ggml-<model>.bin files (default ~/.cache/whisper.cpp), or one model file.
# WHISPER_CPP_MODEL=
# Optional: 1 = pass -tdrz (speaker turns) with a custom tdrz model file; automatic for *tdrz* model names.
# WHISPER_CPP_TDRZ=
# Optional: CPU threads (whisper-cli default: 4), and extra whisper-cli arguments (e.g. -ng to disable the GPU).
# WHISPER_CPP_THREADS=
# WHISPER_CPP_ARGS=
# Optional: another Ollama server (default http://localhost:11434).
# OLLAMA_BASE_URL=
# Optional: only for Ollama's cloud (https://ollama.com); a local server needs no key.
# OLLAMA_API_KEY=
# Optional: context window and longest answer per call, in tokens (defaults 16384 and 8192).
# OLLAMA_NUM_CTX=
# OLLAMA_MAX_TOKENS=
# Optional: thinking for reasoning models: false, true, low, medium, high, or default (the model decides).
# Unset: off, except for steps with effort "high".
# OLLAMA_THINK=
# Optional: json_schema (default) or json_object (format "json" plus the schema in the prompt).
# OLLAMA_RESPONSE_FORMAT=

# --- Recording fixtures for provider tests (docs/contributing/providers.md); secrets are redacted ---
# OVERTONE_RECORD_HTTP=recordings

# --- Downloads ---
# English runs download the CMU Pronouncing Dictionary once (0.95 MB). Optional: the folder for it (default
# $XDG_CACHE_HOME/overtone, else ~/.cache/overtone; %LOCALAPPDATA%\overtone on Windows), or a local copy to use instead.
# OVERTONE_CACHE_HOME=
# OVERTONE_CMUDICT=

# --- Diagnostics ---
# Optional: 1 = also print debug lines (e.g. every usage report) to stderr.
# OVERTONE_DEBUG=

# --- Live test only (npm run test:live); defaults are the CLI defaults ---
# OVERTONE_LIVE_TEXT=azure-openai:<transcribe-deployment>
# OVERTONE_LIVE_TIMING=azure-speech
# OVERTONE_LIVE_LLM=azure-openai:<chat-deployment>
